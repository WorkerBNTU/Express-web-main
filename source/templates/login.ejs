<%- include('includes/header.ejs') %>
    <h1>Вход</h1>
    <form method="post">

    <label for="1">Имя пользователя</label>
    <input type="text" name="username" id="1" value="<%= body.username %>" />
    <% if (errors.username) {%>
        <div>
            <span class="label error"> <%= errors.username.msg %> </span>
        </div>
    <% } %>

    <label for="2">Пароль</label>
    <input type="password" name="password" id="2" value="<%= body.password %>" />
    <% if (errors.password) {%>
        <div>
            <span class="label error"> <%= errors.password.msg %> </span>
        </div>
    <% } %>
    
    <div class="horizontal">
        <input type="submit" value="Войти" />
    </div>

    </form>
<%- include('includes/footer.ejs') %>
